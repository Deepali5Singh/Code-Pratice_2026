#include <stdio.h>
int main()
{
    int v1 [2][2];
    int v2 [2][2];
    int v3 [2] [2];
    int sum = 0;
    int i, j, k; 
    for(i = 0; i<2; i++){
        for(j = 0; j<2; j++){
            scanf("%d",&v1[i][j]);
        }
    }
     for(i = 0; i<2; i++){
